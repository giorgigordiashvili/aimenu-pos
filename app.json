{
  "expo": {
    "name": "AiMenu POS",
    "slug": "aimenu-pos",
    "scheme": "aimenupos",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "ge.aimenu.pos"
    },
    "android": {
      "package": "ge.aimenu.pos"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f93b370-c9b2-4d90-9c3f-0943670a445d"
      }
    },
    "owner": "ggordiashvili",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f93b370-c9b2-4d90-9c3f-0943670a445d"
    }
  }
}
