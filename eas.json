{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.aimenu.ge"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.aimenu.ge"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
